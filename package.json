{
  "name": "questiongame",
  "private": true,
  "version": "1.1.0",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "aAndy03",
    "url": "https://github.com/aAndy03"
  },
  "contributors": [
    {
      "name": "aAndy03",
      "url": "https://github.com/aAndy03"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aAndy03/question-game.git"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:webviews": "node scripts/dev-webviews.mjs",
    "dev:stage": "npm run dev -w @questiongame/stage",
    "dev:studio": "npm run dev -w @questiongame/studio",
    "build": "npm run notices && npm run build --workspaces --if-present",
    "notices": "vite-node scripts/notices.ts",
    "release:check": "vite-node scripts/release-check.ts",
    "release:route": "vite-node scripts/release-route.ts",
    "version:stable": "vite-node scripts/version.ts -- stable",
    "version:beta": "vite-node scripts/version.ts -- beta",
    "typecheck": "tsc --build --force && tsc -p e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:host": "cargo test --manifest-path crates/host/Cargo.toml",
    "test:app": "cargo test -p questiongame-app",
    "test:all": "npm run test && npm run test:host && npm run test:app && npm run test:tools",
    "lint": "eslint .",
    "lint:host": "cargo clippy --manifest-path crates/host/Cargo.toml --all-targets -- -D warnings",
    "lint:app": "cargo clippy -p questiongame-app --all-targets -- -D warnings",
    "tauri": "tauri",
    "dev:app": "tauri dev --config crates/app/tauri.dev.conf.json",
    "fixtures": "vite-node scripts/emit-fixtures.ts",
    "decor:hulls": "vite-node scripts/decor-hulls.ts",
    "studio:icons": "vite-node scripts/studio-icons.ts",
    "audio:placeholders": "vite-node scripts/audio-placeholders.ts",
    "js-stack": "node scripts/js-stack.mjs",
    "release": "npm run typecheck && npm run lint && npm run test:all && npm run map:check && tauri build",
    "leak-probe": "node scripts/leak-probe.mjs",
    "map": "vite-node scripts/codemap.ts",
    "map:check": "vite-node scripts/codemap.ts --check",
    "test:tools": "cargo test -p codemap",
    "lint:tools": "cargo clippy -p codemap --all-targets -- -D warnings",
    "e2e:build": "tauri build --debug --no-bundle --config crates/app/tauri.e2e.conf.json",
    "e2e": "wdio run e2e/wdio.conf.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "svg-path-properties": "^2.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
